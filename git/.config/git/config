[user]
	email = flemming@flamingcode.com
	name = Flemming Andersen
[init]
	defaultBranch = master
[checkout]
	defaultRemote = origin
[pull]
	ff = only
[push]
	default = simple
[fetch]
	prune = true
	pruneTags = true
	all = true
[merge]
	tool = nvimdiff
	conflictstyle = diff3
[mergetool]
	prompt = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
